diff --git a/android/app/src/main/java/com/metallic/chiaki/stream/StreamViewModel.kt b/android/app/src/main/java/com/metallic/chiaki/stream/StreamViewModel.kt
index df69378..dc6d744 100644
--- a/android/app/src/main/java/com/metallic/chiaki/stream/StreamViewModel.kt
+++ b/android/app/src/main/java/com/metallic/chiaki/stream/StreamViewModel.kt
@@ -28,2 +28,19 @@ class StreamViewModel(val application: Application, val connectInfo: ConnectInfo
 
+	private val _displayOnly = MutableLiveData(false)
+	val displayOnly: LiveData<Boolean> get() = _displayOnly
+	val showFullControls = visibleControls(onScreenControlsEnabled)
+	val showTouchpadOnly = visibleControls(touchpadOnlyEnabled)
+
+	private fun visibleControls(enabled: LiveData<Boolean>): LiveData<Boolean> =
+		MediatorLiveData<Boolean>().apply {
+			fun update() { value = enabled.value == true && displayOnly.value != true }
+			addSource(enabled) { update() }
+			addSource(displayOnly) { update() }
+		}
+
+	fun setDisplayOnly(enabled: Boolean) {
+		session.displayOnly = enabled
+		_displayOnly.value = enabled
+	}
+
 	override fun onCleared()
