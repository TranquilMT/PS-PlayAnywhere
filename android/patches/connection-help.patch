+++ b/android/app/src/main/java/com/metallic/chiaki/settings/WanAddress.kt
@@ -0,0 +1,37 @@
+package com.metallic.chiaki.settings
+
+internal enum class WanAddress {
+    INVALID,
+    SHARED,
+    PRIVATE,
+    SPECIAL_USE,
+    POTENTIALLY_PUBLIC;
+
+    companion object {
+        fun classify(input: String): WanAddress {
+            val fields = input.trim().split('.')
+            if (fields.size != 4) return INVALID
+
+            val octets = fields.map { field ->
+                if (field.isEmpty() || field.length > 3 || field.any { it !in '0'..'9' } ||
+                    (field.length > 1 && field.startsWith('0'))
+                ) return INVALID
+                field.toInt().takeIf { it <= 255 } ?: return INVALID
+            }
+
+            val (first, second, third) = octets
+            return when {
+                first == 100 && second in 64..127 -> SHARED
+                first == 10 || (first == 172 && second in 16..31) ||
+                    (first == 192 && second == 168) -> PRIVATE
+                first == 0 || first == 127 || first >= 224 ||
+                    (first == 169 && second == 254) ||
+                    (first == 192 && second == 0 && third in listOf(0, 2)) ||
+                    (first == 198 && second in 18..19) ||
+                    (first == 198 && second == 51 && third == 100) ||
+                    (first == 203 && second == 0 && third == 113) -> SPECIAL_USE
+                else -> POTENTIALLY_PUBLIC
+            }
+        }
+    }
+}
