+package com.metallic.chiaki.settings
+
+import android.content.Context
+import android.view.LayoutInflater
+import androidx.core.view.isVisible
+import androidx.core.widget.doAfterTextChanged
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.metallic.chiaki.R
+import com.metallic.chiaki.databinding.DialogConnectionHelpBinding
+
+internal object ConnectionHelpDialog {
+    fun show(context: Context) {
+        val builder = MaterialAlertDialogBuilder(context)
+        val binding = DialogConnectionHelpBinding.inflate(LayoutInflater.from(builder.context))
+        binding.wanAddress.doAfterTextChanged { value ->
+            binding.wanResult.isVisible = !value.isNullOrBlank()
+            if (!binding.wanResult.isVisible) return@doAfterTextChanged
+
+            val message = when (WanAddress.classify(value.toString())) {
+                WanAddress.INVALID -> R.string.connection_help_invalid
+                WanAddress.SHARED -> R.string.connection_help_shared
+                WanAddress.PRIVATE -> R.string.connection_help_private
+                WanAddress.SPECIAL_USE -> R.string.connection_help_special
+                WanAddress.POTENTIALLY_PUBLIC -> R.string.connection_help_public
+            }
+            binding.wanResult.setText(message)
+        }
+        builder.setTitle(R.string.connection_help_title)
+            .setView(binding.root)
+            .setPositiveButton(android.R.string.ok, null)
+            .show()
+    }
+}
