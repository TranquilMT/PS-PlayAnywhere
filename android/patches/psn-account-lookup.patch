@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+package com.metallic.chiaki.regist
+
+import android.net.Uri
+import android.util.Base64
+import org.json.JSONException
+import org.json.JSONObject
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URI
+import java.net.URISyntaxException
+import java.net.URL
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+internal object PsnAccountLookup {
+    // Same Remote Play client and endpoints as upstream scripts/psn-account-id.py.
+    private const val CLIENT_ID = "ba495a24-818c-472b-b12d-ff231c1b5745"
+    private const val CLIENT_SECRET = "mvaiZkRsAsI1IBkY"
+    private const val AUTH_BASE = "https://auth.api.sonyentertainmentnetwork.com/2.0/oauth"
+    private const val RETURN_URL = "https://remoteplay.dl.playstation.net/remoteplay/redirect"
+
+    fun loginUri(state: String): Uri = Uri.parse("$AUTH_BASE/authorize").buildUpon()
+        .appendQueryParameter("service_entity", "urn:service-entity:psn")
+        .appendQueryParameter("response_type", "code")
+        .appendQueryParameter("client_id", CLIENT_ID)
+        .appendQueryParameter("redirect_uri", RETURN_URL)
+        .appendQueryParameter("scope", "psn:clientapp")
+        .appendQueryParameter("ui", "pr")
+        .appendQueryParameter("smcid", "remoteplay")
+        .appendQueryParameter("state", state)
+        .build()
+
+    fun redirectCode(value: String, state: String): String? {
+        val url = try { URI(value.trim()) } catch (_: URISyntaxException) { return null }
+        if (url.scheme != "https" || url.rawAuthority != "remoteplay.dl.playstation.net" ||
+            url.rawPath != "/remoteplay/redirect" || url.rawFragment != null) return null
+        val uri = Uri.parse(url.toString())
+        if (uri.getQueryParameters("state").singleOrNull() != state ||
+            uri.getQueryParameter("error") != null) return null
+        return uri.getQueryParameters("code").singleOrNull()?.takeIf { it.isNotBlank() }
+    }
+
+    fun fetchAccountId(code: String): String? = try {
+        val body = "grant_type=authorization_code&code=${Uri.encode(code)}&redirect_uri=${Uri.encode(RETURN_URL)}"
+        val token = request("$AUTH_BASE/token", body)?.getString("access_token")
+        val id = token?.takeIf { it.isNotBlank() }?.let {
+            request("$AUTH_BASE/token/${Uri.encode(it)}")?.getString("user_id")?.toULongOrNull()
+        }
+        id?.let {
+            Base64.encodeToString(ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN)
+                .putLong(it.toLong()).array(), Base64.NO_WRAP)
+        }
+    } catch (_: IOException) {
+        null
+    } catch (_: JSONException) {
+        null
+    }
+
+    private fun request(url: String, body: String? = null): JSONObject? {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.instanceFollowRedirects = false
+            connection.connectTimeout = 10_000
+            connection.readTimeout = 10_000
+            val client = Base64.encodeToString("$CLIENT_ID:$CLIENT_SECRET".toByteArray(), Base64.NO_WRAP)
+            connection.setRequestProperty("Authorization", "Basic $client")
+            if (body != null) {
+                connection.requestMethod = "POST"
+                connection.doOutput = true
+                connection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
+                connection.outputStream.use { it.write(body.toByteArray()) }
+            }
+            if (connection.responseCode != 200) return null
+            return connection.inputStream.bufferedReader().use { JSONObject(it.readText()) }
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
