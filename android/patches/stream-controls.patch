index 0000000..9df5e51
--- /dev/null
+++ b/android/app/src/main/java/com/metallic/chiaki/stream/InterpolationView.kt
@@ -0,0 +1,287 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+package com.metallic.chiaki.stream
+
+import android.content.Context
+import android.graphics.SurfaceTexture
+import android.opengl.GLES11Ext.GL_TEXTURE_EXTERNAL_OES
+import android.opengl.GLES20.*
+import android.opengl.GLSurfaceView
+import android.view.Surface
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.concurrent.atomic.AtomicBoolean
+import javax.microedition.khronos.egl.EGLConfig
+import javax.microedition.khronos.opengles.GL10
+
+internal class InterpolationView(
+    context: Context,
+    private val videoWidth: Int,
+    private val videoHeight: Int,
+    onSurface: (Surface) -> Unit,
+    onFailure: () -> Unit
+) : GLSurfaceView(context) {
+    private val engine = Engine(onSurface, onFailure)
+
+    init {
+        setEGLContextClientVersion(2)
+        setRenderer(engine)
+    }
+
+    override fun onPause() {
+        queueEvent { engine.release() }
+        super.onPause()
+    }
+
+    private inner class Engine(
+        private val onSurface: (Surface) -> Unit,
+        private val onFailure: () -> Unit
+    ) : GLSurfaceView.Renderer {
+        private val pending = AtomicBoolean()
+        private val quad = ByteBuffer.allocateDirect(32).order(ByteOrder.nativeOrder())
+            .asFloatBuffer().put(floatArrayOf(-1f, -1f, 1f, -1f, -1f, 1f, 1f, 1f)).apply { position(0) }
+        private val textures = IntArray(4)
+        private val fbo = IntArray(1)
+        private val transform = FloatArray(16)
+        private val motionWidth = maxOf(1, videoWidth / 16)
+        private val motionHeight = maxOf(1, videoHeight / 16)
+        private var camera: SurfaceTexture? = null
+        private var input: Surface? = null
+        private var copy = 0
+        private var estimate = 0
+        private var present = 0
+        private var width = 0
+        private var height = 0
+        private var last = 0L
+        private var arrival = 0L
+        private var interval = 0L
+        private var newest = 0
+        private var interpolate = false
+
+        override fun onSurfaceCreated(gl: GL10?, config: EGLConfig?) {
+            try {
+                copy = program(COPY)
+                estimate = program(ESTIMATE)
+                present = program(PRESENT)
+                glGenTextures(4, textures, 0)
+                configureTexture(GL_TEXTURE_EXTERNAL_OES, textures[3])
+                for (i in 0..2) {
+                    configureTexture(GL_TEXTURE_2D, textures[i])
+                    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA,
+                        if (i == 2) motionWidth else videoWidth, if (i == 2) motionHeight else videoHeight,
+                        0, GL_RGBA, GL_UNSIGNED_BYTE, null)
+                }
+                glGenFramebuffers(1, fbo, 0)
+                for (i in 0..2) target(textures[i], 1, 1)
+                glBindFramebuffer(GL_FRAMEBUFFER, 0)
+                check(glGetError() == GL_NO_ERROR)
+                val texture = SurfaceTexture(textures[3]).apply {
+                    setDefaultBufferSize(videoWidth, videoHeight)
+                    setOnFrameAvailableListener { pending.set(true) }
+                }
+                camera = texture
+                val surface = Surface(texture)
+                input = surface
+                post { if (surface.isValid) onSurface(surface) }
+            } catch (_: RuntimeException) {
+                release()
+                post { onFailure() }
+            }
+        }
+
+        override fun onSurfaceChanged(gl: GL10?, w: Int, h: Int) {
+            width = w
+            height = h
+        }
+
+        override fun onDrawFrame(gl: GL10?) {
+            val texture = camera ?: return
+            try {
+                if (pending.getAndSet(false)) {
+                    texture.updateTexImage()
+                    val timestamp = texture.timestamp
+                    if (timestamp != last) {
+                        arrival = System.nanoTime()
+                        interval = timestamp - last
+                        interpolate = last != 0L && interval in 26_000_000L..43_000_000L
+                        last = timestamp
+                        newest = 1 - newest
+                        texture.getTransformMatrix(transform)
+                        target(textures[newest], videoWidth, videoHeight)
+                        glUseProgram(copy)
+                        sampler(copy, "frame", 0, GL_TEXTURE_EXTERNAL_OES, textures[3])
+                        glUniformMatrix4fv(glGetUniformLocation(copy, "transform"), 1, false, transform, 0)
+                        draw(copy)
+                        if (interpolate) {
+                            target(textures[2], motionWidth, motionHeight)
+                            glUseProgram(estimate)
+                            frameSamplers(estimate)
+                            glUniform2f(glGetUniformLocation(estimate, "pixel"), 1f / videoWidth, 1f / videoHeight)
+                            draw(estimate)
+                        }
+                    }
+                }
+                glBindFramebuffer(GL_FRAMEBUFFER, 0)
+                glViewport(0, 0, width, height)
+                if (last == 0L) {
+                    glClear(GL_COLOR_BUFFER_BIT)
+                    return
+                }
+                glUseProgram(present)
+                frameSamplers(present)
+                sampler(present, "motion", 2, GL_TEXTURE_2D, textures[2])
+                glUniform2f(glGetUniformLocation(present, "pixel"), 1f / videoWidth, 1f / videoHeight)
+                val elapsed = System.nanoTime() - arrival
+                val phase = when {
+                    !interpolate || elapsed >= interval -> 1f
+                    elapsed >= interval * 45 / 100 -> 0.5f
+                    else -> 0f
+                }
+                glUniform1f(glGetUniformLocation(present, "phase"), phase)
+                draw(present)
+            } catch (_: RuntimeException) {
+                // The activity stops the decoder before releasing its input surface.
+                camera?.setOnFrameAvailableListener(null)
+                post { onFailure() }
+            }
+        }
+
+        private fun frameSamplers(p: Int) {
+            sampler(p, "beforeFrame", 0, GL_TEXTURE_2D, textures[1 - newest])
+            sampler(p, "afterFrame", 1, GL_TEXTURE_2D, textures[newest])
+        }
+
+        fun release() {
+            input?.release()
+            input = null
+            camera?.release()
+            camera = null
+            pending.set(false)
+            last = 0L
+            glDeleteTextures(4, textures, 0)
+            glDeleteFramebuffers(1, fbo, 0)
+            for (p in intArrayOf(copy, estimate, present)) if (p != 0) glDeleteProgram(p)
+            copy = 0
+            estimate = 0
+            present = 0
+        }
+
+        private fun configureTexture(target: Int, id: Int) {
+            glBindTexture(target, id)
+            glTexParameteri(target, GL_TEXTURE_MIN_FILTER, GL_LINEAR)
+            glTexParameteri(target, GL_TEXTURE_MAG_FILTER, GL_LINEAR)
+            glTexParameteri(target, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE)
+            glTexParameteri(target, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE)
+        }
+
+        private fun target(id: Int, w: Int, h: Int) {
+            glBindFramebuffer(GL_FRAMEBUFFER, fbo[0])
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, id, 0)
+            check(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
+            glViewport(0, 0, w, h)
+        }
+
+        private fun sampler(p: Int, name: String, unit: Int, type: Int, id: Int) {
+            glActiveTexture(GL_TEXTURE0 + unit)
+            glBindTexture(type, id)
+            glUniform1i(glGetUniformLocation(p, name), unit)
+        }
+
+        private fun draw(p: Int) {
+            val attribute = glGetAttribLocation(p, "position")
+            glEnableVertexAttribArray(attribute)
+            glVertexAttribPointer(attribute, 2, GL_FLOAT, false, 0, quad)
+            glDrawArrays(GL_TRIANGLE_STRIP, 0, 4)
+            glDisableVertexAttribArray(attribute)
+        }
+
+        private fun program(fragment: String): Int {
+            val vertex = shader(GL_VERTEX_SHADER, VERTEX)
+            val frag = shader(GL_FRAGMENT_SHADER, fragment)
+            val p = glCreateProgram()
+            glAttachShader(p, vertex)
+            glAttachShader(p, frag)
+            glLinkProgram(p)
+            glDeleteShader(vertex)
+            glDeleteShader(frag)
+            val status = IntArray(1)
+            glGetProgramiv(p, GL_LINK_STATUS, status, 0)
+            check(status[0] == GL_TRUE)
+            return p
+        }
+
+        private fun shader(type: Int, source: String): Int {
+            val s = glCreateShader(type)
+            glShaderSource(s, source)
+            glCompileShader(s)
+            val status = IntArray(1)
+            glGetShaderiv(s, GL_COMPILE_STATUS, status, 0)
+            check(status[0] == GL_TRUE)
+            return s
+        }
+    }
+
+    private companion object {
+        const val VERTEX = """
+            attribute vec2 position;
+            varying highp vec2 uv;
+            void main() {
+                uv = position * 0.5 + 0.5;
+                gl_Position = vec4(position, 0.0, 1.0);
+            }
+        """
+        const val COPY = """#extension GL_OES_EGL_image_external : require
+            precision mediump float;
+            varying highp vec2 uv;
+            uniform samplerExternalOES frame;
+            uniform mat4 transform;
+            void main() { gl_FragColor = texture2D(frame, (transform * vec4(uv, 0.0, 1.0)).xy); }
+        """
+        const val ESTIMATE = """
+            precision highp float;
+            varying highp vec2 uv;
+            uniform sampler2D beforeFrame, afterFrame;
+            uniform vec2 pixel;
+            float diff(vec2 p, vec2 d) {
+                vec3 a = texture2D(beforeFrame, p - d * 0.5).rgb;
+                vec3 b = texture2D(afterFrame, p + d * 0.5).rgb;
+                return dot(abs(a - b), vec3(0.299, 0.587, 0.114));
+            }
+            void main() {
+                vec2 best = vec2(0.0);
+                float score = 10.0;
+                vec2 s = pixel * 5.0;
+                for (int y = -2; y <= 2; y++) {
+                    for (int x = -2; x <= 2; x++) {
+                        vec2 d = vec2(float(x), float(y));
+                        vec2 v = d * pixel * 6.0;
+                        float e = (diff(uv, v) + diff(uv + vec2(s.x, 0.0), v) +
+                            diff(uv - vec2(s.x, 0.0), v) + diff(uv + vec2(0.0, s.y), v) +
+                            diff(uv - vec2(0.0, s.y), v)) * 0.2 + 0.002 * length(d);
+                        if (e < score) { score = e; best = d; }
+                    }
+                }
+                gl_FragColor = vec4(best * 0.25 + 0.5, 1.0 - smoothstep(0.04, 0.14, score), 1.0);
+            }
+        """
+        const val PRESENT = """
+            precision highp float;
+            varying highp vec2 uv;
+            uniform sampler2D beforeFrame, afterFrame, motion;
+            uniform vec2 pixel;
+            uniform float phase;
+            void main() {
+                if (phase < 0.25) {
+                    gl_FragColor = texture2D(beforeFrame, uv);
+                } else if (phase > 0.75) {
+                    gl_FragColor = texture2D(afterFrame, uv);
+                } else {
+                    vec3 field = texture2D(motion, uv).rgb;
+                    vec2 halfShift = (field.xy - 0.5) * 12.0 * pixel;
+                    vec4 a = texture2D(beforeFrame, uv - halfShift);
+                    vec4 b = texture2D(afterFrame, uv + halfShift);
+                    gl_FragColor = mix(texture2D(afterFrame, uv), (a + b) * 0.5, field.z);
+                }
+            }
+        """
+    }
+}
