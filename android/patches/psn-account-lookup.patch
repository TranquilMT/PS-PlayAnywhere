@@ -83,2 +107,49 @@ class RegistActivity: AppCompatActivity(), RevealActivity
 
+	private fun showPsnRedirectDialog() {
+		val state = viewModel.psnState
+		if (state == null) {
+			Toast.makeText(this, R.string.psn_sign_in_first, Toast.LENGTH_LONG).show()
+			return
+		}
+		val input = EditText(this).apply {
+			inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_URI
+			isSaveEnabled = false
+			importantForAutofill = View.IMPORTANT_FOR_AUTOFILL_NO
+			setSingleLine(true)
+		}
+		val dialog = MaterialAlertDialogBuilder(this)
+			.setTitle(R.string.psn_paste_redirect)
+			.setMessage(R.string.psn_redirect_instructions)
+			.setView(input)
+			.setNegativeButton(android.R.string.cancel, null)
+			.setPositiveButton(android.R.string.ok, null)
+			.show()
+		dialog.getButton(android.content.DialogInterface.BUTTON_POSITIVE).setOnClickListener {
+			val code = PsnAccountLookup.redirectCode(input.text.toString(), state)
+			if (code == null) {
+				input.error = getString(R.string.psn_redirect_invalid)
+				return@setOnClickListener
+			}
+			viewModel.psnState = null
+			input.text.clear()
+			dialog.dismiss()
+			binding.psnPasteButton.isEnabled = false
+			binding.psnSignInButton.isEnabled = false
+			binding.registButton.isEnabled = false
+			lifecycleScope.launch {
+				val id = withContext(Dispatchers.IO) { PsnAccountLookup.fetchAccountId(code) }
+				if (id == null) {
+					Toast.makeText(this@RegistActivity, R.string.psn_lookup_failed, Toast.LENGTH_LONG).show()
+				} else if (viewModel.ps4Version.value != RegistViewModel.ConsoleVersion.PS4_LT_7) {
+					binding.psnIdEditText.setText(id)
+					binding.psnIdEditText.error = null
+					binding.pinEditText.requestFocus()
+				}
+				binding.psnPasteButton.isEnabled = true
+				binding.psnSignInButton.isEnabled = true
+				binding.registButton.isEnabled = true
+			}
+		}
+	}
+
 	private fun doRegist()
