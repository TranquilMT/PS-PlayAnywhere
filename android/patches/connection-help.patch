+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="connection_help_title">Connection help</string>
+    <string name="connection_help_summary">Troubleshoot pairing, rest mode and home network access</string>
+    <string name="connection_help_steps">Pair and test on the same network while your PS5 is awake. Check that Remote Play is enabled in the console settings.\n\nFor wake from rest mode, enable internet access and network wake in the console’s rest mode settings. A successful wake only confirms that the wake request reached the console. Test video and controls separately.\n\nTo play over 5G through a home VPN: Pair on home Wi-Fi first and leave the PS5 awake. Turn Wi-Fi off and connect a home VPN that gives your phone access to the PS5’s LAN. Choose Add Console Manually, enter the PS5’s LAN IP under Host, select your existing PS5 under Registered Console, then save and open the entry. If direct access fails, check the WAN address shown on your home router below. This check runs on your phone and the app does not save the address.</string>
+    <string name="connection_help_wan_label">Home router WAN IPv4 (optional)</string>
+    <string name="connection_help_invalid">Enter a dotted IPv4 address with four numbers from 0 to 255.</string>
+    <string name="connection_help_shared">This address is in the shared range used by carrier-grade NAT. Forwarding a port on your home router alone cannot make the console reachable through upstream NAT.</string>
+    <string name="connection_help_private">This address is private. Check whether a modem, another router or your provider is routing traffic upstream. If you have two routers, check the internet-facing one.</string>
+    <string name="connection_help_special">This address is reserved for special use. Check the internet-facing router’s WAN status for its assigned address.</string>
+    <string name="connection_help_public">This address is outside common private and shared ranges. Reachability still depends on your network. Confirm it with a Remote Play session from another network.</string>
+</resources>
