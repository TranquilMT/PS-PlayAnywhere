+	private fun motionEnabled(): Boolean =
+		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) ValueAnimator.areAnimatorsEnabled()
+		else Settings.Global.getFloat(contentResolver, Settings.Global.ANIMATOR_DURATION_SCALE, 1f) > 0f
+
+	private fun configurePlatformPreview(button: TextView, title: Int, details: Int)
+	{
+		button.text = getString(R.string.platform_preview_label, getString(title), getString(R.string.platform_coming_soon))
+		button.setOnClickListener {
+			val dialog = MaterialAlertDialogBuilder(this)
+				.setTitle(title)
+				.setMessage(details)
+				.setPositiveButton(android.R.string.ok, null)
+				.show()
+			if (motionEnabled()) {
+				dialog.window?.decorView?.let { panel ->
+					panel.alpha = 0f
+					panel.scaleX = 0.97f
+					panel.scaleY = 0.97f
+					panel.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(160).start()
+				}
+			}
+		}
+	}
+
+	private fun showBrandIntro()
+	{
+		val intro = layoutInflater.inflate(R.layout.playanywhere_intro, null)
+		addContentView(intro, ViewGroup.LayoutParams(-1, -1))
+
+		val mark = intro.findViewById<View>(R.id.introMark)
+		mark.scaleX = 0.72f
+		mark.scaleY = 0.72f
+		mark.rotation = -14f
+		reveal(mark, 0, 460)
+		mark.animate().scaleX(1f).scaleY(1f).rotation(0f)
+		reveal(intro.findViewById(R.id.introWordmark), 100, 360)
+		reveal(intro.findViewById(R.id.introTagline), 180, 320)
+
+		intro.animate().alpha(0f).setStartDelay(620).setDuration(180).withEndAction {
+			(intro.parent as? ViewGroup)?.removeView(intro)
+			reveal(binding.platformRow, 0, 200)
+		}.start()
+	}
+
+	private fun reveal(view: View, delay: Long, duration: Long)
+	{
+		view.alpha = 0f
+		view.translationY = 10f * resources.displayMetrics.density
+		view.animate().alpha(1f).translationY(0f).setStartDelay(delay).setDuration(duration)
+			.setInterpolator(DecelerateInterpolator()).start()
+	}
+
