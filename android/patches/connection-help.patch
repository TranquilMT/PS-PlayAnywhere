@@ -0,0 +1,29 @@
+package com.metallic.chiaki.settings
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class WanAddressTest {
+    @Test
+    fun sharedRangeIncludesBothBoundaries() {
+        assertEquals(WanAddress.SHARED, WanAddress.classify("100.64.0.0"))
+        assertEquals(WanAddress.SHARED, WanAddress.classify("100.127.255.255"))
+        assertEquals(WanAddress.POTENTIALLY_PUBLIC, WanAddress.classify("100.63.255.255"))
+        assertEquals(WanAddress.POTENTIALLY_PUBLIC, WanAddress.classify("100.128.0.0"))
+    }
+
+    @Test
+    fun privateAndSpecialUseAddresses() {
+        for (address in listOf(" 10.0.0.1 ", "172.16.0.1", "172.31.255.255", "192.168.0.1"))
+            assertEquals(address, WanAddress.PRIVATE, WanAddress.classify(address))
+        for (address in listOf("0.0.0.0", "127.0.0.1", "169.254.0.1", "192.0.2.1", "198.51.100.1", "203.0.113.1", "224.0.0.1"))
+            assertEquals(address, WanAddress.SPECIAL_USE, WanAddress.classify(address))
+        assertEquals(WanAddress.POTENTIALLY_PUBLIC, WanAddress.classify("172.32.0.1"))
+    }
+
+    @Test
+    fun malformedInputsStayInvalid() {
+        for (address in listOf("", "router.local", "192.168.1", "192.168.1.256", "192.168.1.1:80", "1.2.3.4.", "::1", "01.2.3.4", "+1.2.3.4"))
+            assertEquals(address, WanAddress.INVALID, WanAddress.classify(address))
+    }
+}
