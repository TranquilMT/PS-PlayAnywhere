+<resources>
+    <string name="psn_sign_in">Sign in with PlayStation</string>
+    <string name="psn_paste_redirect">Paste sign-in return link</string>
+    <string name="psn_redirect_instructions">After signing in on the PlayStation page, copy the full return URL from your browser and paste it here. The return page may appear blank. Keep the link private.</string>
+    <string name="psn_browser_unavailable">A web browser is required for PlayStation sign-in.</string>
+    <string name="psn_sign_in_first">Start PlayStation sign-in first.</string>
+    <string name="psn_redirect_invalid">Paste the PlayStation return link from the current sign-in.</string>
+    <string name="psn_lookup_failed">Could not get the Account ID. Start a new sign-in or enter the Account ID manually.</string>
+</resources>
