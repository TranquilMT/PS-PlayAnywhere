diff --git a/android/app/src/main/java/com/metallic/chiaki/main/XboxActivity.kt b/android/app/src/main/java/com/metallic/chiaki/main/XboxActivity.kt
new file mode 100644
index 0000000..6de863b
--- /dev/null
+++ b/android/app/src/main/java/com/metallic/chiaki/main/XboxActivity.kt
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+package com.metallic.chiaki.main
+
+import android.content.ActivityNotFoundException
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.widget.Button
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import com.metallic.chiaki.R
+
+class XboxActivity : AppCompatActivity() {
+    private val companionPackage = "com.redphx.betterxc"
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_xbox)
+        supportActionBar?.hide()
+        val panel = findViewById<android.view.View>(R.id.xboxPanel)
+        ViewCompat.setOnApplyWindowInsetsListener(panel) { view, insets ->
+            val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout())
+            view.setPadding(bars.left, bars.top, bars.right, bars.bottom)
+            insets
+        }
+        findViewById<Button>(R.id.xboxBack).setOnClickListener { finish() }
+        findViewById<Button>(R.id.xboxWeb).setOnClickListener { open(web("https://www.xbox.com/play")) }
+        findViewById<Button>(R.id.xboxCompanion).setOnClickListener {
+            open(packageManager.getLaunchIntentForPackage(companionPackage)
+                ?: web("https://github.com/redphx/better-xcloud-android/releases"))
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        val installed = packageManager.getLaunchIntentForPackage(companionPackage) != null
+        findViewById<Button>(R.id.xboxCompanion).setText(
+            if (installed) R.string.xbox_companion_launch else R.string.xbox_companion_get)
+    }
+
+    private fun web(url: String) = Intent(Intent.ACTION_VIEW, Uri.parse(url)).apply {
+        addCategory(Intent.CATEGORY_BROWSABLE)
+    }
+
+    private fun open(intent: Intent) {
+        try {
+            startActivity(intent)
+        } catch (e: ActivityNotFoundException) {
+            Toast.makeText(this, R.string.xbox_open_error, Toast.LENGTH_LONG).show()
+        }
+    }
+}
