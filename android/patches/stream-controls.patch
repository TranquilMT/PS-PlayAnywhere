+	private fun visibleControls(enabled: LiveData<Boolean>): LiveData<Boolean> =
+		MediatorLiveData<Boolean>().apply {
+			fun update() { value = enabled.value == true && displayOnly.value != true }
+			addSource(enabled) { update() }
+			addSource(displayOnly) { update() }
+		}
+
+	fun setDisplayOnly(enabled: Boolean) {
+		session.displayOnly = enabled
+		_displayOnly.value = enabled
+	}
